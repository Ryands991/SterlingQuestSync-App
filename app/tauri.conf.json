{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sterling Quest Sync",
  "version": "0.1.0",
  "identifier": "com.sterlingaddons.questsync",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sterling Quest Sync",
        "width": 820,
        "height": 560,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "SterlingAddons",
    "shortDescription": "Offline quest sync for Sterling Quest Tracker",
    "copyright": "MIT",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
